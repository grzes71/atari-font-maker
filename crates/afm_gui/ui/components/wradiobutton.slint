// WinForms-like radio button with explicit dark text and a circular
// indicator. Unlike the stock Slint controls, the label color is hard-coded
// to black so it stays readable on light backgrounds under every platform
// and style (the stock Slint CheckBox/ComboBox can render a light or
// invisible label on Windows).

export component WRadioButton inherits Rectangle {
    in property <string> text;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback clicked();

    background: transparent;

    indicator := Rectangle {
        x: 0px;
        y: Math.max(0px, (root.height - 11px) / 2);
        width: 11px;
        height: 11px;
        border-radius: 6px;
        background: #ffffff;
        border-width: 1px;
        border-color: #7a7a7a;
        if root.checked : Rectangle {
            x: 3px;
            y: 3px;
            width: 5px;
            height: 5px;
            border-radius: 3px;
            background: #000000;
        }
    }

    Text {
        x: 16px;
        y: 0px;
        width: root.width - 16px;
        height: root.height;
        text: root.text;
        color: root.enabled ? #000000 : #888888;
        font-size: 10px;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}
