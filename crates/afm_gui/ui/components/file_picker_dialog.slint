import { Button, LineEdit } from "std-widgets.slint";

export component FilePickerDialog inherits Rectangle {
    in property <bool> is_open: false;
    in property <bool> save_mode: false;
    in property <string> current_dir: "";
    in property <[string]> dirs;
    in property <[string]> files;
    in-out property <string> file_name: "";

    callback navigate(string);
    callback select_file(string);
    callback cancel();

    visible: root.is_open;
    background: #000000aa;

    Rectangle {
        width: 560px;
        height: 460px;
        background: #252526;
        border_color: #007acc;
        border_width: 2px;
        border-radius: 6px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            HorizontalLayout {
                Text {
                    text: root.save_mode ? "💾 Save Project As" : "📂 Open Project";
                    color: #ffffff;
                    font_size: 15px;
                    font_weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "✕";
                    clicked => { root.cancel(); }
                }
            }

            HorizontalLayout {
                Button {
                    text: "⬆ Up";
                    clicked => { root.navigate(".."); }
                }
                Text {
                    text: root.current_dir;
                    color: #9cdcfe;
                    font_size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            // Directories
            Text { text: "Directories:"; color: #cccccc; font_size: 12px; }
            Rectangle {
                height: 120px;
                background: #1e1e1e;
                border_width: 1px;
                border_color: #3a3a3a;
                clip: true;
                VerticalLayout {
                    for d in root.dirs : Button {
                        text: "📁 " + d;
                        horizontal-stretch: 1;
                        clicked => { root.navigate(d); }
                    }
                }
            }

            // Files
            Text { text: "Files:"; color: #cccccc; font_size: 12px; }
            Rectangle {
                height: 150px;
                background: #1e1e1e;
                border_width: 1px;
                border_color: #3a3a3a;
                clip: true;
                VerticalLayout {
                    for f in root.files : Button {
                        text: "📄 " + f;
                        horizontal-stretch: 1;
                        clicked => { root.select_file(f); }
                    }
                }
            }

            // Save-mode filename input
            if root.save_mode : HorizontalLayout {
                Text { text: "File name:"; color: #cccccc; font_size: 12px; vertical-alignment: center; }
                LineEdit {
                    text <=> root.file_name;
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
                Button {
                    text: root.save_mode ? "Save" : "Open";
                    primary: true;
                    clicked => { root.select_file(root.save_mode ? root.file_name : ""); }
                }
            }
        }
    }
}
