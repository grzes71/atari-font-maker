// WinForms-like checkbox with explicit dark text, so the label stays readable
// on light backgrounds under every platform/style (the stock Slint CheckBox
// renders a light/invisible label on Windows).

export component WCheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback clicked();

    background: transparent;

    box := Rectangle {
        x: 0px; y: 1px; width: 13px; height: 13px;
        background: #ffffff;
        border-width: 1px;
        border-color: #7a7a7a;
        if root.checked : Text {
            text: "✓";
            color: #000000;
            font-size: 10px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 17px; y: 0px;
        text: root.text;
        color: root.enabled ? #000000 : #888888;
        font-size: 10px;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}
